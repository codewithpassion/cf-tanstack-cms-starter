# Clerk (required: the admin area signs in through it)
# Clerk publishable key - exposed to the client via Vite
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk publishable key - read by the Hono @clerk/hono middleware (same value as above)
CLERK_PUBLISHABLE_KEY=
# Clerk secret key
CLERK_SECRET_KEY=

# Who may use /admin: comma-separated email addresses, case-insensitive. The
# address must be verified on the Clerk account. Empty means nobody is an admin.
ADMIN_EMAILS=

# HMAC key that signs draft-preview and share-image render tokens. At least 32
# characters, e.g. the output of `openssl rand -base64 32`.
PREVIEW_SIGNING_KEY=

# Claude API key for the AI page agent (optional). Without it the agent only
# offers Workers AI models.
ANTHROPIC_API_KEY=

# Google Search Console sync (optional). An OAuth client and a refresh token for
# the account that owns the property named in GSC_PROPERTY (wrangler.jsonc vars).
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# One-click dev login (optional). When set, GET /api/dev-login signs in as
# this Clerk user via a one-time sign-in token - no Clerk UI needed. Create
# the user with `bun run create-dev-user` after setting these.
# NEVER set these in a deployed environment: their presence is what enables
# the route, so leaving them unset in production is the safety switch.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Cloudflare account to deploy to (optional). Only needed when `wrangler whoami`
# lists more than one account; wrangler reads it from this file.
CLOUDFLARE_ACCOUNT_ID=

# The database is a D1 binding, not a connection string: see `d1_databases` in
# wrangler.jsonc. Nothing to set here for it.
