{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  // Generated by the shadcn CLI and regenerated on upgrade. Biome must not touch
  // these: `ultracite fix` has been observed to corrupt combobox.tsx by duplicating
  // a JSX attribute. Linting them is pointless too - the findings could only ever be
  // resolved by editing vendored code.
  "files": {
    "includes": ["!**/components/ui", "!**/hooks/use-mobile.ts"]
  },
  // CMS code (ported from a sibling project): `type` aliases, because interfaces
  // lose index-signature assignability to Record<string, unknown>, which the ops
  // engine and page service rely on. No key, JSX attribute or class sorting:
  // schema key order is also the editor's field order.
  "overrides": [
    {
      "includes": [
        "packages/cms-core/**",
        "packages/db/**",
        "packages/services/**",
        "apps/web/src/modules/cms/**",
        "apps/web/src/server/**",
        "apps/web/src/routes/**"
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": "off",
            "useSortedKeys": "off"
          }
        }
      },
      "linter": {
        "rules": {
          "nursery": {
            "useSortedClasses": "off"
          },
          "style": {
            "useConsistentTypeDefinitions": {
              "level": "error",
              "options": { "style": "type" }
            }
          }
        }
      }
    }
  ]
}
